# All of these are shared secrets between this app's own client, server,
# and simulated Stripe/Twilio layer — NOT credentials for any real
# Stripe/Twilio/Supabase account. See CLAUDE.md → "Env vars" for details
# on what each one actually does and gotchas (especially the
# NEXT_PUBLIC_ one, which is baked in at build time, not read at runtime).
# Sensible defaults are used if any of these are omitted; set your own
# only if you want non-default values (e.g. a different demo-reset key).

# Signs/verifies simulated Stripe webhook deliveries.
STRIPE_WEBHOOK_SECRET=whsec_dev_secret

# Signs/verifies simulated Twilio status-callback webhooks.
TWILIO_ACCOUNT_SID=ACtest0000000000000000000000000000
TWILIO_AUTH_TOKEN=dev_test_auth_token
TWILIO_FROM_NUMBER=+15550123456

# Must match the actual origin this app is served from — used to build
# the URL Twilio-callback signatures are computed over.
APP_BASE_URL=http://localhost:3000

# Gates GET /demo-reset. Not real security — just enough to stop an
# accidental tap/crawl wiping a live demo.
DEMO_RESET_SECRET=letmein
# Same value as above, exposed to the browser so the Demo Mode widget's
# "Reset Demo" button can call /demo-reset itself. Requires a rebuild
# (`next build`) to take effect, unlike the server-only vars above.
NEXT_PUBLIC_DEMO_RESET_KEY=letmein
